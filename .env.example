# AppealCrafter Environment Configuration
# Copy to .env and fill in real values. Never commit .env.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_TITLE=AppealCrafter API
API_VERSION=1.0.0

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=appealcrafter
DATABASE_USER=appealcrafter
DATABASE_PASSWORD=change-me
DATABASE_SSL_MODE=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30

# Security
SECURITY_JWT_SECRET=replace-with-a-random-32+char-secret
SECURITY_JWT_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRY_MINUTES=60
SECURITY_REFRESH_TOKEN_EXPIRY_DAYS=7
SECURITY_ISSUER=appealcrafter
SECURITY_AUDIENCE=appealcrafter-api
SECURITY_CORS_ORIGINS=["http://localhost:3000"]
SECURITY_BCRYPT_ROUNDS=12

# Email Provider
EMAIL_PROVIDER=log_only
EMAIL_FROM_ADDRESS=no-reply@example.org
EMAIL_FROM_NAME=AppealCrafter
EMAIL_PHYSICAL_ADDRESS=123 Main St, Anytown, USA
EMAIL_WEBHOOK_SECRET=replace-with-a-random-16+char-secret
EMAIL_FREQUENCY_CAP_DAYS=14
# EMAIL_SENDGRID_API_KEY=
# EMAIL_POSTMARK_SERVER_TOKEN=
# EMAIL_SES_ACCESS_KEY_ID=
# EMAIL_SES_SECRET_ACCESS_KEY=
# EMAIL_SES_REGION=

# Redis
REDIS_URL=redis://localhost:6379/0

# Error Tracking
# SENTRY_DSN=